[
    {
        "description": "validation of URIs",
        "schema": { "format": "uri" },
        "tests": [
            {
                "description": "a valid URI",
                "data": "http://foo.bar/?baz=qux#quux",
                "valid": true
            },
            {
                "description": "an invalid protocol-relative URI Reference",
                "data": "//foo.bar/?baz=qux#quux",
                "valid": false
            },
            {
                "description": "an invalid URI",
                "data": "\\\\WINDOWS\\fileshare",
                "valid": false
            },
            {
                "description": "an invalid URI though valid URI reference",
                "data": "abc",
                "valid": false
            },
            {
                "description": "non-numeric port is invalid",
                "data": "http://example.com:abc/path",
                "valid": false
            },
            {
                "description": "leading zero in an embedded IPv4 address is invalid",
                "data": "http://[::ffff:01.2.3.4]",
                "valid": false
            },
            {
                "description": "an IPv6 address without enclosing brackets is invalid",
                "data": "http://2001:0db8:85a3:0000:0000:8a2e:0370:7334",
                "valid": false
            }
        ]
    }
]
